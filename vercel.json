{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "website": {
      "root": "website",
      "framework": "vite"
    },
    "web": {
      "root": "web",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "website"
      }
    }
  ]
}
