// FIXLY Prisma Schema Blueprint
// Matches plan.md Section 5 Database Schema Design

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  TECHNICIAN
  RIDER
}

enum OrderStatus {
  PICKUP_SCHEDULED
  PICKUP_COMPLETED
  DEVICE_RECEIVED
  DIAGNOSIS_PENDING
  ESTIMATE_SENT
  ESTIMATE_APPROVED
  ESTIMATE_REJECTED
  REPAIR_IN_PROGRESS
  QUALITY_CHECK_PASSED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model User {
  id                  String        @id @default(uuid())
  phoneNumber         String        @unique
  name                String?
  email               String?
  role                UserRole      @default(CUSTOMER)
  fcmToken            String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  addresses           Address[]
  customerOrders      RepairOrder[] @relation("CustomerOrders")
  assignedRiderOrders RepairOrder[] @relation("RiderOrders")
  assignedTechOrders  RepairOrder[] @relation("TechOrders")
}

model Address {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  label       String        // Home, Office, Other
  addressLine String
  landmark    String?
  city        String
  pincode     String
  latitude    Float?
  longitude   Float?
  orders      RepairOrder[]
}

model DeviceBrand {
  id      String        @id @default(uuid())
  name    String        @unique // Apple, Samsung, OnePlus, Xiaomi, etc.
  iconUrl String?
  logoText String?
  color   String?
  models  DeviceModel[]
}

model DeviceModel {
  id         String        @id @default(uuid())
  brandId    String
  brand      DeviceBrand   @relation(fields: [brandId], references: [id])
  name       String        // Xiaomi 11i 5G, iPhone 14, Galaxy S23
  imageUrl   String?
  year       String?
  network    String?
  spareParts SparePart[]
  orders     RepairOrder[]
}

model SparePart {
  id            String         @id @default(uuid())
  modelId       String
  model         DeviceModel    @relation(fields: [modelId], references: [id])
  partName      String         // Original OLED Screen, Battery 3200mAh
  partCode      String         @unique
  costPrice     Decimal        @db.Decimal(10, 2)
  sellingPrice  Decimal        @db.Decimal(10, 2)
  stockQuantity Int            @default(0)
  minThreshold  Int            @default(5)
  estimateItems EstimateItem[]
}

model RepairServiceCatalog {
  id                    String  @id @default(uuid())
  code                  String  @unique // display, battery, charging-port, camera, speaker, water-damage
  title                 String
  subtitle              String
  basePrice             Decimal @db.Decimal(10, 2)
  warrantyText          String
  isLiveStreamSupported Boolean @default(true)
  icon                  String
  sortOrder             Int     @default(0)
}

model RepairOrder {
  id               String          @id @default(uuid())
  orderNumber      String          @unique // e.g. QF-2026-00123
  customerId       String
  customer         User            @relation("CustomerOrders", fields: [customerId], references: [id])
  modelId          String
  model            DeviceModel     @relation(fields: [modelId], references: [id])
  addressId        String
  pickupAddress    Address         @relation(fields: [addressId], references: [id])
  
  riderId          String?
  rider            User?           @relation("RiderOrders", fields: [riderId], references: [id])
  technicianId     String?
  technician       User?           @relation("TechOrders", fields: [technicianId], references: [id])

  status           OrderStatus     @default(PICKUP_SCHEDULED)
  pickupSlot       DateTime
  issueDescription String
  customerMedia    String[]        @default([]) // S3/R2 URLs of uploaded images/videos
  diagnosisNotes   String?
  pickupFee        Decimal         @default(79.00) @db.Decimal(10, 2)

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  timeline         OrderTimeline[]
  estimate         Estimate?
  payments         Payment[]
  warranty         Warranty?
}

model OrderTimeline {
  id          String      @id @default(uuid())
  orderId     String
  order       RepairOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  title       String
  description String
  timestamp   DateTime    @default(now())
}

model Estimate {
  id              String         @id @default(uuid())
  orderId         String         @unique
  order           RepairOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pickupFee       Decimal        @default(79.00) @db.Decimal(10, 2)
  laborFee        Decimal        @default(0.00) @db.Decimal(10, 2)
  discount        Decimal        @default(0.00) @db.Decimal(10, 2)
  totalAmount     Decimal        @db.Decimal(10, 2)
  isApproved      Boolean?
  rejectionReason String?
  items           EstimateItem[]
  invoiceUrl      String?
  createdAt       DateTime       @default(now())
}

model EstimateItem {
  id         String     @id @default(uuid())
  estimateId String
  estimate   Estimate   @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  partId     String?
  part       SparePart? @relation(fields: [partId], references: [id])
  title      String
  amount     Decimal    @db.Decimal(10, 2)
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  order             RepairOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
}

model Warranty {
  id         String      @id @default(uuid())
  orderId    String      @unique
  order      RepairOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  startDate  DateTime
  endDate    DateTime    // 30 days from delivery
  isActive   Boolean     @default(true)
  claimNotes String?
}
